      "source": [
        "# Получаем только числовые столбцы\n",
        "numeric_columns = df.select_dtypes(exclude='object').columns\n",
        "\n",
        "# Создаем словарь для хранения результатов\n",
        "results = {}\n",
        "\n",
        "for column in numeric_columns:\n",
        "    # Вычисляем все необходимые метрики\n",
        "    median_val = df[column].median()\n",
        "    variance = df[column].var()\n",
        "    q1 = df[column].quantile(0.25)\n",
        "    q3 = df[column].quantile(0.75)\n",
        "    iqr = q3 - q1\n",
        "\n",
        "    # Определяем выбросы\n",
        "    lower_bound = q1 - 1.5 * iqr\n",
        "    upper_bound = q3 + 1.5 * iqr\n",
        "    outliers = ((df[column] < lower_bound) | (df[column] > upper_bound)).sum()\n",
        "    has_outliers = outliers > 0\n",
        "\n",
        "    results[column] = {\n",
        "        'Медиана': round(median_val, 2),\n",
        "        'Дисперсия': round(variance, 2),\n",
        "        'IQR': round(iqr, 2),\n",
        "        'Наличие выбросов': 'Да' if has_outliers else 'Нет',\n",
        "        'Количество выбросов': outliers\n",
        "    }\n",
        "\n",
        "# Преобразуем результаты в DataFrame для удобного отображения\n",
        "results_df = pd.DataFrame(results)\n",
        "results_df\n"
