        "\n",
        "from scipy import stats\n",
        "# НУлевая гипотеза (H0): Распределение рейтингов не зависит от страны происхождения бобов\n",
        "# Альтернативная гипотеза (H1): Распределение рейтингов зависит от страны происхождения бобов\n",
        "# Создание таблицы контингенции\n",
        "contingency_table = pd.crosstab(df['Broad Bean\\nOrigin'],\n",
        "                    pd.cut(df['Rating'], bins=3, labels=['Низкий', 'Средний', 'Высокий']))\n",
        "\n",
        "# Вычисление статистики χ² и p-значения\n",
        "chi2, p_value, dof, expected = stats.chi2_contingency(contingency_table)\n",
        "\n",
        "print(\"\\nХи-квадрат результаты:\")\n",
        "print(f\"Хи-квадрат статистика: {chi2}\")\n",
        "print(f\"p-значение: {p_value}\")\n",
        "\n",
        "# Обоснование гипотезы\n",
        "if p_value < 0.05:\n",
        "    print(\"Отвергаем нулевую гипотезу. Распределение рейтингов зависит от страны происхождения бобов \")\n",
